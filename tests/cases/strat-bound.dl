% Four predicates chained by negation need four strata, as many as there are
% predicates: the chain has no cycle, so it must be accepted with s3 in
% stratum 3 rather than mistaken for recursion through negation.
s0(1).
s1(X) :- s0(X), not s0(X).
s2(X) :- s1(X), not s1(X).
s3(X) :- s2(X), not s2(X).
