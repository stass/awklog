% Recursive components: path reaches itself, and p and q reach
% themselves through each other; edge and base do not and can skip the delta
% loop.  All of it is one stratum, since no negation raises anything.
edge(a, b).
edge(b, c).
path(X, Y) :- edge(X, Y).
path(X, Z) :- edge(X, Y), path(Y, Z).
base(x).
p(X) :- q(X).
q(X) :- p(X).
q(X) :- base(X).
