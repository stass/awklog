% "Used" means named in some body or query, so predicates that only read each
% other -- even and odd here, and the self-recursive chain -- count as used
% although no query reads any of them.  This is a known limit of the warning,
% stated in the README.
zero(0).
succ(0, 1).
succ(1, 2).
even(X) :- zero(X).
even(Y) :- odd(X), succ(X, Y).
odd(Y) :- even(X), succ(X, Y).
chain(X, Y) :- succ(X, Y).
chain(X, Z) :- succ(X, Y), chain(Y, Z).
